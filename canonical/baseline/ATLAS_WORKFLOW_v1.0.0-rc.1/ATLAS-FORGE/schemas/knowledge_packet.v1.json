{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Evidence Packet v1",
  "type": "object",
  "required": [
    "packet_id",
    "claim",
    "evidence_kind",
    "review_status",
    "source_id",
    "source_url",
    "source_locator",
    "inspected_scope",
    "applicability",
    "limitations",
    "rights",
    "version",
    "content_sha256"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "editorial",
        "source_reported",
        "formal_derivation",
        "simulation",
        "synthetic",
        "measured",
        "reproduced"
      ]
    },
    "review_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "editorial_pending_review",
        "portion_checked",
        "human_reviewed",
        "independently_reproduced"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "inspected_scope": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "rights": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "review_artifact": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "calibration_context": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "independently_reproduced"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "reproduced"
          }
        },
        "required": [
          "reviewer",
          "review_artifact"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "const": "measured"
          }
        },
        "required": [
          "evidence_kind"
        ]
      },
      "then": {
        "required": [
          "artifact_sha256",
          "instrument",
          "calibration_context",
          "units"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "enum": [
              "human_reviewed",
              "independently_reproduced"
            ]
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "required": [
          "reviewer",
          "review_artifact"
        ]
      }
    }
  ]
}
